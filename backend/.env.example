# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL - Render PostgreSQL, Supabase, Neon, or Local)
# Example: postgresql://postgres:password@localhost:5432/tbtrack
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Configuration (Vercel Frontend URL & Localhost)
FRONTEND_URL=http://localhost:5173,https://tbtrack.vercel.app
