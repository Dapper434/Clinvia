# Server Configuration
PORT=5000
FLASK_ENV=development

# Database Connection (PostgreSQL - Supabase, Render, Neon, or Local)
# Example: postgresql://postgres:password@localhost:5432/tbtrack
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Configuration (Frontend URL & Localhost)
FRONTEND_URL=http://localhost:5173,https://tbtrack.vercel.app

# Web push dose reminders
# Generate a key pair once (see README "Dose reminders") and keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@yourhospital.org
# Shared secret the scheduler sends in the X-Cron-Secret header to POST /api/reminders/run
REMINDER_CRON_SECRET=
APP_TIMEZONE=Africa/Nairobi
# First-line TB drugs: once daily on an empty stomach, i.e. before breakfast
DEFAULT_DOSE_TIME=07:00

# Patient "Talk to AI" companion (any OpenAI-compatible chat API). Leave the key empty to use safe rule-based replies.
# Groq (default): AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.3-70b-versatile
# Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.0-flash
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Network admins sign in at this domain; hospitals get <name>.<domain> by default.
NETWORK_EMAIL_DOMAIN=clinvia.health

# Passwords for the seeded accounts (flask seed-network). One per seeded hospital,
# one for the network admin, one shared by seeded patient portal accounts.
SEED_PASSWORD_NETWORK=
SEED_PASSWORD_KNH=
SEED_PASSWORD_KIAMBU=
SEED_PASSWORD_NAKURU=
SEED_PASSWORD_MACHAKOS=
SEED_PASSWORD_THIKA=
SEED_PASSWORD_PATIENTS=
